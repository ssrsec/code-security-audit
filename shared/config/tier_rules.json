      "extensions": [".py", ".pyi"],
      "vendor_prefixes": ["site-packages/", "venv/", ".venv/", "env/", "lib/python"]
    },
    {
      "id": "go",
      "entry_layer": ["handler", "handlers", "api", "router", "routers", "server", "http", "endpoint", "middleware", "web"],
      "business_layer": ["service", "services", "repo", "repos", "pkg", "config", "internal", "manager", "usecase"],
      "data_layer": ["model", "models", "entity", "entities", "dto", "schema"],
      "extensions": [".go"],
      "vendor_prefixes": ["vendor/"]
    },
    {
      "id": "php",
      "entry_layer": ["controller", "controllers", "routes", "index", "api", "http", "action", "endpoint", "middleware"],
      "business_layer": ["service", "services", "model", "repository", "config", "manager", "helper", "util"],
      "data_layer": ["entity", "entities", "model", "models", "dto", "valueobject"],
      "extensions": [".php", ".phtml"],
