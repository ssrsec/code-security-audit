      "data_layer": ["entity", "entities", "vo", "dto", "model", "models", "pojo", "domain"],
      "annotations": { "T1": ["Controller", "RestController", "WebServlet", "Filter", "Interceptor", "RequestMapping"], "T2": ["Service", "Repository", "Mapper", "Component"], "T3": ["Entity", "Table", "Data", "Document"] },
      "extensions": [".java", ".kt", ".xml", ".yml", ".yaml", ".properties"],
      "vendor_prefixes": ["com/alibaba/", "org/springframework/", "org/apache/", "javax/", "jakarta/", "ch/qos/", "org/slf4j/", "org/hibernate/", "org/mybatis/", "io/swagger/", "com/google/", "org/junit/"]
    },
    {
      "id": "node",
