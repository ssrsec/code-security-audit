      "business_layer": ["service", "services", "model", "models", "utils", "config", "lib", "core", "repository", "manager"],
      "data_layer": ["schema", "schemas", "model", "models", "entity", "dto", "types"],
      "extensions": [".js", ".ts", ".tsx", ".mjs", ".cjs"],
      "vendor_prefixes": ["node_modules/"]
    },
    {
      "id": "python",
      "entry_layer": ["views", "view", "urls", "routes", "handlers", "api", "endpoints", "web", "http", "app"],
      "business_layer": ["service", "services", "utils", "settings", "config", "core", "repository", "manager", "business"],
