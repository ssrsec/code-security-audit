  "skip_patterns": ["test/", "/test/", "tests/", "__tests__/", "spec/", ".spec.", "mock/", "mocks/", "stub/", "stubs/", "fixture/", "fixtures/", "example/", "examples/", "sample/", "samples/", "e2e/", "integration/", "benchmark/", ".test.", ".spec."],
