{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-security-audit.local/schemas/evidence.schema.json",
  "title": "Validation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "findingId", "environment", "executedAt", "assertions", "limitations"],
  "properties": {
    "schemaVersion": { "const": "evidence/v1" },
    "id": { "type": "string", "pattern": "^ev-[A-Za-z0-9._-]+$" },
    "findingId": { "type": "string", "pattern": "^vul-[0-9]{3,}$" },
    "requestRef": { "type": "string", "pattern": "^req-[A-Za-z0-9._-]+$" },
    "environment": { "enum": ["live-target", "local", "unit", "mock", "static"] },
    "executedAt": { "type": "string", "minLength": 1 },
    "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 },
    "responseSnippet": { "type": "string" },
    "stdout": { "type": "string" },
    "stderr": { "type": "string" },
    "exitCode": { "type": ["integer", "null"] },
    "environmentFingerprint": { "type": "object" },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "expected", "actual", "passed"],
        "properties": {
          "type": { "enum": ["contains", "equals", "timing", "row-count", "file-exists", "status-code", "regex", "diff"] },
          "expected": {},
          "actual": {},
          "passed": { "type": "boolean" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
